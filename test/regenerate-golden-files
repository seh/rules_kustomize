#!/usr/bin/env bash

set -E -e -u -o pipefail

cd "$(realpath "$(dirname "${BASH_SOURCE[0]}")/..")"

test_target_labels="$(bazelisk query 'kind("^diff_test rule$", tests(//test:all))')"

xargs bazelisk build <<<"${test_target_labels}"

while IFS='' read -r test_target_label; do
  result_file="$(bazelisk cquery --output=files "labels(file1, ${test_target_label})")"
  golden_file="$(bazelisk cquery --output=files "labels(file2, ${test_target_label})")"
  if [ ! -e "${golden_file}" ] || ! diff -q "${golden_file}" "${result_file}" >/dev/null; then
    cp -p "${result_file}" "${golden_file}"
    chmod 644 "${golden_file}"
  fi
done <<<"${test_target_labels}"
