load(
    "{containing_package_prefix}:toolchain.bzl",
    "helm_tool",
    "helm_toolchain",
)

alias(
    name = "binary",
    actual = "helm{extension}",
    visibility = ["@{toolchains_repo}//:__pkg__"],
)

helm_tool(
    name = "tool",
    binary = ":binary",
    version = "{version}",
)

helm_toolchain(
    name = "toolchain",
    tool = ":tool",
)
