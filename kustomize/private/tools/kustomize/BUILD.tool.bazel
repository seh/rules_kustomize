load(
    "{containing_package_prefix}:toolchain.bzl",
    "kustomize_tool",
    "kustomize_toolchain",
)

alias(
    name = "binary",
    actual = "kustomize{extension}",
    visibility = ["@{toolchains_repo}//:__pkg__"],
)

kustomize_tool(
    name = "tool",
    binary = ":binary",
    version = "{version}",
)

kustomize_toolchain(
    name = "toolchain",
    tool = ":tool",
)
